# Copy to .env (git-ignored) or to /etc/wal-ingestor/wal-ingestor.env.
# Every setting is optional; see `ingestor -h` for the full list and defaults.

LISTEN_ADDR=:8080
DATA_DIR=./data

# Where processed messages go. Empty = store and discard (useful for trials).
# Never put credentials in the URL: use SINK_AUTHORIZATION / SINK_HEADERS.
SINK_URL=http://localhost:9000/events
# SINK_AUTHORIZATION=Bearer change-me
# SINK_HEADERS=X-Api-Key: change-me, X-Tenant: acme
# Destination statuses that dead-letter a message instead of retrying it.
# SINK_PERMANENT_STATUSES=400,413,415,422

# Behind a reverse proxy, name it so the per-client rate limit sees real IPs.
# TRUSTED_PROXIES=10.0.0.0/8, 127.0.0.1
# PROXY_HEADER=X-Forwarded-For
# RATE_LIMIT_PER_MINUTE=600

# Enables HMAC-SHA256 verification (header X-Signature-256: sha256=<hex>).
# WEBHOOK_SECRET=change-me

# Health and metrics, bound to localhost by default. ADMIN_ADDR= disables it.
ADMIN_ADDR=127.0.0.1:9090

LOG_LEVEL=info
LOG_FORMAT=text
